# Leave DATABASE_URL empty to use the embedded PGlite database in ./.data/pglite (zero setup, single process).
# Set it to use a real PostgreSQL server (required in production).
#
# Local docker-compose:
#   DATABASE_URL=postgres://openslot:openslot@localhost:5432/openslot
#
# Neon (production / Vercel): use the DIRECT (unpooled) connection string, not the pooled
# "-pooler" one — the app uses interactive transactions, which need a session connection.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: where the embedded database lives. Use "memory" for throwaway runs.
PGLITE_DIR=./.data/pglite

# Optional: Postgres connection pool size. 1 is right for serverless (Vercel + Neon).
DB_POOL_MAX=1

# Shared secret for the scheduled job that expires unanswered offers (/api/cron/expire-offers).
CRON_SECRET=change-me
