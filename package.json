{
  "name": "nidhub",
  "version": "0.1.0",
  "private": true,
  "description": "NidHub — live availability, waitlists and operations for childcare centres (and later clinics, hospitals and venues).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/require-env.mjs DATABASE_URL && npm run db:migrate && npm run db:seed && npm run db:import-ontario && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:import-ontario": "tsx src/db/import-ontario.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "drizzle-orm": "^0.45.4",
    "next": "^14.2.35",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
